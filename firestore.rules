rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    // The requester's own profile doc — cached by Firestore within a
    // single rule evaluation, so calling this more than once is cheap.
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActiveUser() { return isSignedIn() && me().active == true; }
    function role() { return me().role; }
    function isAdmin() { return isActiveUser() && role() == 'admin'; }
    function isManager() { return isActiveUser() && role() == 'manager'; }
    function isAdminOrManager() { return isAdmin() || isManager(); }
    // Only an Admin explicitly flagged canManageAccounts (Jewel) can
    // create, block/unblock, or remove other accounts. Every other Admin
    // (e.g. Bahar) keeps full operational access but not this. Uses
    // .get() with a default so accounts created before this field existed
    // don't error out — they're just treated as false (safe default).
    function canManageAccounts() { return isAdmin() && me().get('canManageAccounts', false) == true; }
    // A Staff account only gets edit rights on invoices/challans/clients
    // if Jewel explicitly turned that on for them individually — off by
    // default. Moderator and Admin always have it via isAdminOrManager().
    function canEditFull() {
      return isAdminOrManager()
        || (isActiveUser() && role() == 'staff' && me().get('canEditRecords', false) == true);
    }

    // True if the signed-in user is allowed into the given section
    // ('dashboard' | 'stock' | 'sale' | 'invoices' | 'clients').
    function hasTab(tab) {
      return isActiveUser() && (
        role() == 'admin' || role() == 'manager' ||
        (role() == 'staff' && tab in me().tabs)
      );
    }

    // One-time bootstrap gate: true once the initial Admin + Manager
    // accounts have been created, so the open self-write rules below
    // close automatically after first-run setup.
    function setupDone() {
      return exists(/databases/$(database)/documents/meta/setupComplete)
        && get(/databases/$(database)/documents/meta/setupComplete).data.done == true;
    }

    // True if the TARGET account (not the requester) has shielded itself
    // from other admins via "Hide me from other admins" in Staff Accounts.
    function targetIsShielded(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.get('shielded', false) == true;
    }

    // NOTE: there is deliberately no public "directory" collection anymore.
    // Before this change, a name+role list had to be publicly readable so
    // the login screen could show a tappable list before anyone signed in.
    // Login now works by typing a username instead, so nothing about any
    // account needs to be visible pre-authentication — including whether
    // it exists at all. Any leftover /directory/* documents from an older
    // version of this app are automatically inaccessible below, since
    // paths with no matching rule are denied by default.

    // Full staff profile: role, tabs, active flag, shielded flag,
    // canManageAccounts flag. Never contains a PIN — Firebase Auth
    // verifies the PIN, not this doc.
    match /users/{uid} {
      // Any active admin can READ the list (so Bahar can still view Staff
      // Accounts) as long as the target isn't shielded — but only the
      // account-manager can WRITE it.
      allow read: if isSignedIn() && (request.auth.uid == uid || (isAdmin() && !targetIsShielded(uid)));
      allow create: if canManageAccounts() || (!setupDone() && isSignedIn() && request.auth.uid == uid);
      // The account-manager can edit/block/remove anyone EXCEPT a shielded
      // account. Anyone can always toggle the 'shielded' flag on their own
      // doc, and only that flag — this is how self-shielding is enforced
      // server-side, not just hidden in the UI.
      allow update: if (canManageAccounts() && !targetIsShielded(uid))
        || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shielded']));
      allow delete: if canManageAccounts() && !targetIsShielded(uid);
    }

    match /meta/setupComplete {
      allow read: if true;
      allow create, update: if isSignedIn() && !setupDone();
    }

    // Digital signature & seal — any active account can read them (needed
    // to view/print documents); only Admin or Moderator can change them.
    match /settings/branding {
      allow read: if isActiveUser();
      allow write: if isAdminOrManager();
    }

    // Dashboard advertisement — Jewel-only to edit. NOT covered by a
    // generic /settings/{id} wildcard on purpose: Firestore merges access
    // across every matching block, so a broad wildcard here would have
    // accidentally let Moderator edit this too. Keeping every settings
    // doc as its own explicit match avoids that trap.
    match /settings/ad {
      allow read: if isActiveUser();
      allow write: if canManageAccounts();
    }

    // Login page notice — must be publicly readable, since it's shown
    // before anyone signs in. Still Jewel-only to write.
    match /settings/loginNotice {
      allow read: if true;
      allow write: if canManageAccounts();
    }

    match /products/{id} {
      allow read: if hasTab('stock') || hasTab('sale') || hasTab('dashboard');
      allow update: if hasTab('stock') || hasTab('sale') || canEditFull();
      allow create, delete: if hasTab('stock') || isAdminOrManager();
    }

    match /clients/{id} {
      allow read: if hasTab('clients') || hasTab('sale') || hasTab('dashboard');
      allow create: if hasTab('clients') || hasTab('sale');
      allow update, delete: if canEditFull();
    }

    match /invoices/{id} {
      allow read: if hasTab('invoices') || hasTab('dashboard') || hasTab('clients');
      allow create: if hasTab('sale');
      allow update, delete: if canEditFull();
    }

    match /payments/{id} {
      allow read: if hasTab('clients') || hasTab('dashboard');
      allow create: if hasTab('clients') || hasTab('sale');
      allow update, delete: if canEditFull();
    }

    match /meta/counters {
      allow read: if isActiveUser();
      allow write: if hasTab('sale');
    }
  }
}
